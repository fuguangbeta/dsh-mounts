{
  "name": "dsh-mounts",
  "version": "1.2.0",
  "private": true,
  "description": "DSH sidebar panel: a Global/Workspace tree of project brief, memory, skills, and MCP servers, with effective-status dots. The only write is a workspace handoff file.",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "author": "fuguangbeta"
}
